# ─────────────────────────────────────────────
# StudyMate AI — Backend Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Groq AI API Key (Recommended — ultra-fast Llama 3.3 70B inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral AI API Key — https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Google Gemini API Key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (optional — defaults to 3001)
PORT=3001

# Set to true for offline testing mode without an API key:
MOCK_AI_RESPONSE=false
